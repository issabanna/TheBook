# Configure through your hosting provider's secret settings; never commit real values.
PAYPAL_ENV=live
PAYPAL_RECEIVER_EMAIL=
PAYPAL_PDT_TOKEN=
PAYPAL_ITEM_NUMBER=LIFE-SECRETS
# Current payment link identifies this product by title instead of SKU.
PAYPAL_ITEM_NAME=Life secrets book
BOOK_ENCRYPTION_KEY=
DOWNLOAD_SIGNING_KEY=
# Optional verified-domain sender and Resend key for IPN email receipts.
RESEND_API_KEY=
EMAIL_FROM=

# Fixed recipient for website questions (server only; never shown to visitors).
CONTACT_TO=

# Optional separate encryption key for Testing-only editorial PDF editions; configure as a Sites secret.
PREMIUM_EDITION_KEY=

# Optional separate key for the postcard-style Testing revision; keep prior edition keys for rollback.
PREMIUM_POSTCARD_KEY=

# Separate Testing graph-card edition key. Keep previous keys available for rollback.
PREMIUM_GRAPH_KEY=

# Password admin access. Set both as secret runtime variables through Sites.
# ADMIN_PASSWORD_HASH format: 16-byte hex salt + dot + PBKDF2-SHA256 100000-iteration 32-byte hex hash.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_KEY=

# New Testing-only catalogue. Preserve the current collection keys for rollback.
TESTING_CATALOGUE_KEY=

# Current three-page book previews. Preserve older keys for rollback.
BOOK_SAMPLE_KEY=

# Shared $7.99 checkout: ISO UTC activation timestamp; preserve for receipt recovery.
SHARED_BOOK_CHECKOUT_FROM=
# Set false to pause new shared-title sales without revoking existing delivery.
SHARED_BOOK_SALES_ENABLED=

# Existing Meta dataset only. Runtime-disabled until the reviewed release is approved.
META_PIXEL_ID=4490808921236945
META_TRACKING_ENABLED=false
# Configure as a server-side Sites secret; never put a real value in this file.
META_CAPI_ACCESS_TOKEN=
# A test deployment must use a separate sandbox PayPal configuration/database.
# Test mode accepts sandbox payments only and supplies a Meta Test Events code.
META_TEST_MODE=false
META_TEST_EVENT_CODE=
# ISO UTC activation timestamp for genuine new purchases; no historical backfill.
META_PURCHASES_FROM=
